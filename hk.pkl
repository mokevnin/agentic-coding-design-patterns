amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

// Vendored skills, pinned by hash in skills-lock.json; never edited here.
exclude = List(".agents/skills/**", ".claude/skills/**")

local checks = new Mapping<String, Step> {
    ["betterleaks"] = Builtins.betterleaks
    ["typos"] = Builtins.typos
    ["rumdl"] = Builtins.rumdl
    ["jactionlint"] = Builtins.jactionlint
    ["oxlint"] = Builtins.ox_lint
    // Markdown stays with rumdl: book prose uses one physical line per paragraph.
    ["oxfmt"] = (Builtins.oxfmt) {
        glob = List("*.js", "*.json", "*.css", "*.yml", "*.yaml", "*.toml")
        exclude = List("pnpm-lock.yaml", "skills-lock.json")
    }
    ["syncpack"] {
        glob = List("package.json", "pnpm-workspace.yaml", ".syncpackrc.json")
        check = "syncpack lint"
        fix = "syncpack fix"
    }
    // Check references across the whole book, beyond the files selected by the hook.
    ["links"] = (Builtins.lychee) {
        glob = List("*.md", "book/**", "templates/**")
        check = "lychee --offline --no-progress '*.md' 'book/**/*.md' 'templates/**/*.md'"
    }
    ["merge-conflicts"] = Builtins.check_merge_conflict
    ["case-conflicts"] = Builtins.check_case_conflict
    ["symlinks"] = Builtins.check_symlinks
    ["agnix"] {
        glob = List("AGENTS.md", "CLAUDE.md", ".claude/**", ".agnix.toml")
        check = "agnix --strict ."
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = checks
    }
    ["commit-msg"] {
        steps {
            ["commitlint"] {
                check = "commitlint --edit {{commit_msg_file}}"
            }
        }
    }
    // `mise run check` and CI.
    ["check"] {
        steps = checks
    }
    ["fix"] {
        fix = true
        steps = checks
    }
}
